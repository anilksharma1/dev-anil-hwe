# Azure Storage
# Local (Azurite):
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;

# Production (managed identity) — use these instead of the connection string
AZURE_STORAGE_QUEUE_URL=https://<storage-account>.queue.core.windows.net/
AZURE_STORAGE_TABLE_URL=https://<storage-account>.table.core.windows.net/

# Credential type: "cli" forces AzureCliCredential (local dev); omit for DefaultAzureCredential (production)
AZURE_CREDENTIAL_TYPE=cli

# Queue names
AZURE_QUEUE_NAME=doc-processing
AZURE_DEAD_LETTER_QUEUE_NAME=doc-processing-deadletter

# Windows queue routing — legacy office files (.doc/.xls/.ppt) processed on Windows machine
# scaling-lib enqueue routes these here automatically; Worker() on win32 polls this queue.
AZURE_WINDOWS_QUEUE_NAME=doc-processing-windows
# WINDOWS_FILE_EXTENSIONS=.doc,.xls,.ppt  # default; uncomment to customise

# Table name
AZURE_TABLE_NAME=DocProcessingStatus

# Baked into the image at build time via ARG JOB_TYPE
JOB_TYPE=pii-triage

# Docker volume mount paths
INPUT_MOUNT=I:\
OUTPUT_MOUNT=O:\

# Worker tuning (optional — defaults shown; infra default for WORKER_MAX_ATTEMPTS is 2)
QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
WORKER_MAX_ATTEMPTS=2
WORKER_IDLE_EXIT_SECONDS=120

# Files processed simultaneously (threads) within ONE container. worker.py ships a
# default of 4 (scaling-lib's own built-in default is 1, i.e. effectively serial, if this
# is left unset entirely) -- the single biggest built-in throughput lever, since I/O-bound
# work (network reads on OUTPUT_MOUNT/INPUT_MOUNT, OCR/LLM calls) genuinely overlaps across
# threads. Raise it, but size (WORKER_CONCURRENCY x replica count) against your Azure
# OpenAI / Document Intelligence deployment's RPM -- that product is what actually hits
# those rate limits, not file count.
WORKER_CONCURRENCY=4

# Optional: App Insights — inject at runtime, never bake into the image
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional: local log file path (default: app.log)
LOG_FILE_PATH=app.log

# --- ACR / deployment (used by scaling-lib acr-* commands) ---
ACR_REGISTRY=<registry-name>.azurecr.io
ACR_IMAGE=pii_triage
AZURE_CONTAINER_APP=<container-app-name>
AZURE_RESOURCE_GROUP=<resource-group-name>

# --- AI services (injected by infra — for use in your worker code) ---
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano
# Fallback deployment name, checked wherever AZURE_OPENAI_DEPLOYMENT is read
AZURE_OPENAI_DEPLOYMENT_GPT_5_4_NANO=gpt-5.4-nano
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure Document Intelligence
AZURE_DI_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/

# Optional: override context window for a non-standard deployment (tokens)
# AOAI_CONTEXT_WINDOW=128000

# --- pii_triage worker settings ---
# Feature flags (set to "true" or "1" to enable; all off by default)
# USE_OCR=false
# USE_LLM=false
# USE_NER=false

# Tuning (optional — defaults shown)
# BDE_THRESHOLD=51
# FILE_TIMEOUT_S=120
# MAX_BYTES=1073741824
# MAX_SCAN_CHARS=5000000
# MAX_SCAN_ROWS=200000

# Windows leg only: how long to wait for one legacy .doc/.xls/.ppt -> OOXML COM
# conversion before force-killing it as "lost" and moving on (no retry -- a hung
# conversion hangs again for the same duration, so retrying it wastes this budget
# twice for nothing). Falls back to FILE_TIMEOUT_S if unset.
# CONVERT_TIMEOUT_S=120

# Path to a custom rule pack JSON/YAML (leave unset to use the built-in Master List)
# RULEPACK_PATH=
